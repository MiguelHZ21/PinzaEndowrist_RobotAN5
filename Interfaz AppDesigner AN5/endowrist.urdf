<?xml version="1.0"?>
<robot name="endowrist">
<!-- Eslabón base del instrumento -->
<link name="tool_base_link"/>

<!-- Articulación y Eslabón de Inserción -->
<joint name="tool_insertion_joint" type="prismatic">
<parent link="tool_base_link"/>
<child link="tool_shaft_link"/>
<axis xyz="0 0 1"/>
<limit lower="0.0" upper="0.2" effort="10" velocity="0.1"/>
</joint>
<link name="tool_shaft_link"/>

<!-- Articulación y Eslabón de Rolido -->
<joint name="tool_roll_joint" type="continuous">
<parent link="tool_shaft_link"/>
<child link="wrist_pitch_link"/>
<axis xyz="0 0 1"/>
</joint>
<link name="wrist_pitch_link"/>

<!-- Articulación de Cabeceo -->
<joint name="wrist_pitch_joint" type="revolute">
<parent link="wrist_pitch_link"/>
<child link="wrist_yaw_link"/>
<axis xyz="1 0 0"/>
<limit lower="-1.57" upper="1.57" effort="5" velocity="0.5"/>
</joint>
<link name="wrist_yaw_link"/>

<!-- Articulación de Agarre -->
<joint name="gripper_joint" type="revolute">
<parent link="wrist_yaw_link"/>
<child link="gripper_link"/>
<axis xyz="0 1 0"/>
<limit lower="0.0" upper="0.78" effort="2" velocity="1.0"/>
</joint>
<link name="gripper_link"/>
</robot>
